# Configuracao de Producao - To De Olho na VM Contabo
#
# Em producao este arquivo NAO e criado a mao: o workflow
# .github/workflows/deploy.yml o gera em /opt/todeolho/.env a partir dos
# secrets do repositorio. Este exemplo serve para execucao local do
# docker-compose.contabo.yml e como documentacao das chaves exigidas.
#
# O endereco da VM nao e versionado: o dominio esta atras da Cloudflare e
# expor o IP de origem anularia essa protecao. Ele vive no secret CONTABO_HOST.

# Banco de Dados PostgreSQL
POSTGRES_USER=todeolho_user
POSTGRES_PASSWORD=alterar_por_senha_forte_e_segura
POSTGRES_DB=todeolho

# Chave do Portal da Transparencia (Controladoria-Geral da Uniao)
TRANSPARENCIA_API_KEY=sua_chave_aqui

# Segredo exigido nas rotas de sync/backfill (header X-Sync-Secret).
# Gerar com: openssl rand -hex 32
SYNC_SECRET=gerar_hash_aleatorio_32_bytes

# Ano inicial do backfill (legislatura atual)
INICIO_BACKFILL=2023

# Frontend Next.js
NEXT_PUBLIC_API_URL=https://todeolho.org
