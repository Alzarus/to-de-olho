# Portal da Transparência API key (não commitar)
TRANSPARENCIA_API_KEY=

# Anos para sincronização via cmd/sync_emendas_real (ex: 2024,2025)
EMENDAS_ANOS=

# Caminho do CSV para backfill via cmd/seed_emendas
EMENDAS_CSV_PATH=

# Segredo compartilhado dos endpoints POST /api/v1/sync/* (header X-Sync-Secret).
# Obrigatório: sem ele a API recusa todo sync com 503. Gerar com:
#   openssl rand -hex 32
SYNC_SECRET=
