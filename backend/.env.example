# Portal da Transparência API key (não commitar)
TRANSPARENCIA_API_KEY=

# Anos para sincronização via cmd/sync_emendas_real (ex: 2024,2025)
EMENDAS_ANOS=

# Caminho do CSV para backfill via cmd/seed_emendas
EMENDAS_CSV_PATH=

# Segredo compartilhado dos endpoints POST /api/v1/sync/* (header X-Sync-Secret).
# Obrigatório: sem ele a API recusa todo sync com 503. Gerar com:
#   openssl rand -hex 32
SYNC_SECRET=

# Pool de conexões com o Postgres. O padrão (20 abertas, 10 ociosas) deixa
# folga no max_connections=100 do Postgres para psql, backup e manutenção.
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10

# Limite de requisições por origem (token bucket em memória, resposta 429 com
# Retry-After). Taxa 0 desliga o grupo. /health nunca é limitado.
# Visitante: por IP do visitante (CF-Connecting-IP; IPv6 agrupado por /64).
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=40
# Interno: um balde único para requisições sem CF-Connecting-IP vindas de rede
# privada ou loopback (SSR do Next pela rede do Docker, curl no host).
RATE_LIMIT_INTERNO_RPS=50
RATE_LIMIT_INTERNO_BURST=200
# POST /api/v1/acessos (contador de visitas da home), por visitante.
RATE_LIMIT_ACESSOS_POR_MINUTO=1
RATE_LIMIT_ACESSOS_BURST=10
# Quantos IPs ficam na memória ao mesmo tempo; acima disso os IPs novos
# dividem um balde de excedente (protege contra quem gira IPs forjados).
RATE_LIMIT_MAX_VISITANTES=100000
